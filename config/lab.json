{
  "segments": {
    "wan":      {"network": "192.0.2.0/24",      "gateway": "192.0.2.1",     "interface": "e-wan",    "name": "Simulated external network"},
    "dmz":      {"network": "10.77.10.0/24",     "gateway": "10.77.10.1",    "interface": "e-dmz",    "name": "Public services DMZ"},
    "staff":    {"network": "10.77.20.0/24",     "gateway": "10.77.20.1",    "interface": "e-staff",  "name": "Employee network"},
    "app":      {"network": "10.77.30.0/25",     "gateway": "10.77.30.1",    "interface": "e-app",    "name": "Server network, application tier"},
    "vault":    {"network": "10.77.30.128/25",   "gateway": "10.77.30.129",  "interface": "e-vault",  "name": "Server network, restricted data tier"},
    "identity": {"network": "10.77.40.0/24",     "gateway": "10.77.40.1",    "interface": "e-id",     "name": "Identity services network"},
    "admin":    {"network": "10.77.50.0/24",     "gateway": "10.77.50.1",    "interface": "e-admin",  "name": "Administration network"},
    "sensor":   {"network": "10.77.60.0/24",     "gateway": "10.77.60.1",    "interface": "e-sensor", "name": "Security monitoring network"},
    "guest":    {"network": "10.77.70.0/24",     "gateway": "10.77.70.1",    "interface": "e-guest",  "name": "Guest network"},
    "vpn":      {"network": "10.77.90.0/24",     "gateway": "10.77.90.1",    "interface": "wg0",      "name": "WireGuard remote access"}
  },
  "nodes": {
    "outside":     {"segment": "wan",      "ip": "192.0.2.20"},
    "upstream":    {"segment": "wan",      "ip": "192.0.2.80"},
    "remote_user": {"segment": "wan",      "ip": "192.0.2.30"},
    "remote_ops":  {"segment": "wan",      "ip": "192.0.2.31"},
    "web":         {"segment": "dmz",      "ip": "10.77.10.10"},
    "employee":    {"segment": "staff",    "ip": "10.77.20.10"},
    "api":         {"segment": "app",      "ip": "10.77.30.10"},
    "vault":       {"segment": "vault",    "ip": "10.77.30.130"},
    "resolver":    {"segment": "identity", "ip": "10.77.40.10"},
    "admin":       {"segment": "admin",    "ip": "10.77.50.10"},
    "monitor":     {"segment": "sensor",   "ip": "10.77.60.10"},
    "guest":       {"segment": "guest",    "ip": "10.77.70.10"},
    "user_vpn":    {"segment": "vpn",      "ip": "10.77.90.10"},
    "ops_vpn":     {"segment": "vpn",      "ip": "10.77.90.11"}
  },
  "services": {
    "public_web": {"node": "web",      "port": 443,   "kind": "public",    "host": "web.lab.test"},
    "app":        {"node": "api",      "port": 8443,  "kind": "mtls",      "host": "app.lab.test",     "roles": ["employee", "remote_user"]},
    "ops":        {"node": "api",      "port": 9443,  "kind": "mtls",      "host": "ops.lab.test",     "roles": ["operator"]},
    "vault":      {"node": "vault",    "port": 8443,  "kind": "mtls",      "host": "vault.lab.test",   "roles": ["operator"]},
    "dashboard":  {"node": "monitor",  "port": 8443,  "kind": "mtls",      "host": "monitor.lab.test", "roles": ["operator"]},
    "dns":        {"node": "resolver", "port": 53,    "kind": "dns"},
    "egress":     {"node": "upstream", "port": 8080,  "kind": "egress"},
    "vpn":        {"node": "edge",     "port": 51820, "kind": "wireguard"}
  },
  "peers": {
    "user_vpn": {"transport": "remote_user", "service": "app", "identity": "remote_user"},
    "ops_vpn":  {"transport": "remote_ops",  "service": "ops", "identity": "operator"}
  },
  "permits": [
    {"id": "wan_web",         "from": "outside",     "service": "public_web", "protocols": ["tcp"],        "nat": "dnat"},
    {"id": "wan_vpn_user",    "from": "remote_user", "service": "vpn",        "protocols": ["udp"]},
    {"id": "wan_vpn_ops",     "from": "remote_ops",  "service": "vpn",        "protocols": ["udp"]},
    {"id": "employee_app",    "from": "employee",    "service": "app",        "protocols": ["tcp"],        "identity": "employee"},
    {"id": "employee_dns",    "from": "employee",    "service": "dns",        "protocols": ["udp", "tcp"]},
    {"id": "employee_egress", "from": "employee",    "service": "egress",     "protocols": ["tcp"],        "nat": "snat"},
    {"id": "dmz_dns",         "from": "web",         "service": "dns",        "protocols": ["udp", "tcp"]},
    {"id": "guest_dns",       "from": "guest",       "service": "dns",        "protocols": ["udp", "tcp"]},
    {"id": "guest_egress",    "from": "guest",       "service": "egress",     "protocols": ["tcp"],        "nat": "snat"},
    {"id": "admin_dns",       "from": "admin",       "service": "dns",        "protocols": ["udp", "tcp"]},
    {"id": "admin_ops",       "from": "admin",       "service": "ops",        "protocols": ["tcp"],        "identity": "operator"},
    {"id": "admin_vault",     "from": "admin",       "service": "vault",      "protocols": ["tcp"],        "identity": "operator"},
    {"id": "admin_dashboard", "from": "admin",       "service": "dashboard",  "protocols": ["tcp"],        "identity": "operator"},
    {"id": "user_app",        "from": "user_vpn",    "service": "app",        "protocols": ["tcp"],        "identity": "remote_user"},
    {"id": "user_dns",        "from": "user_vpn",    "service": "dns",        "protocols": ["udp", "tcp"]},
    {"id": "ops_dns",         "from": "ops_vpn",     "service": "dns",        "protocols": ["udp", "tcp"]},
    {"id": "ops_admin",       "from": "ops_vpn",     "service": "ops",        "protocols": ["tcp"],        "identity": "operator"},
    {"id": "ops_vault",       "from": "ops_vpn",     "service": "vault",      "protocols": ["tcp"],        "identity": "operator"},
    {"id": "ops_dashboard",   "from": "ops_vpn",     "service": "dashboard",  "protocols": ["tcp"],        "identity": "operator"},
    {"id": "sensor_app_health", "from": "monitor",   "service": "app",        "protocols": ["tcp"],        "identity": "observer", "path": "/health"}
  ],
  "denials": [
    {"id": "wan_direct_dmz",   "from": "outside",  "service": "public_web", "protocol": "tcp"},
    {"id": "wan_private_app",  "from": "outside",  "service": "app",       "protocol": "tcp"},
    {"id": "wan_unknown_peer", "from": "outside",  "service": "vpn",       "protocol": "udp"},
    {"id": "dmz_private_app",  "from": "web",      "service": "app",       "protocol": "tcp"},
    {"id": "dmz_admin",        "from": "web",      "service": "ops",       "protocol": "tcp"},
    {"id": "dmz_egress",       "from": "web",      "service": "egress",    "protocol": "tcp"},
    {"id": "employee_ops",     "from": "employee", "service": "ops",       "protocol": "tcp"},
    {"id": "employee_monitor", "from": "employee", "service": "dashboard", "protocol": "tcp"},
    {"id": "employee_vault",   "from": "employee", "service": "vault",     "protocol": "tcp"},
    {"id": "guest_app",        "from": "guest",    "service": "app",       "protocol": "tcp"},
    {"id": "guest_dmz",        "from": "guest",    "service": "public_web", "protocol": "tcp"},
    {"id": "guest_monitor",    "from": "guest",    "service": "dashboard", "protocol": "tcp"},
    {"id": "guest_admin",      "from": "guest",    "service": "ops",       "protocol": "tcp"},
    {"id": "guest_direct_dns_udp", "from": "guest", "service": "dns",      "protocol": "udp", "address": "192.0.2.80"},
    {"id": "guest_direct_dns_tcp", "from": "guest", "service": "dns",      "protocol": "tcp", "address": "192.0.2.80"},
    {"id": "guest_egress_other_port", "from": "guest", "service": "egress", "protocol": "tcp", "port": 8081},
    {"id": "vpn_user_ops",     "from": "user_vpn", "service": "ops",       "protocol": "tcp"},
    {"id": "vpn_user_vault",   "from": "user_vpn", "service": "vault",     "protocol": "tcp"},
    {"id": "vpn_user_monitor", "from": "user_vpn", "service": "dashboard", "protocol": "tcp"},
    {"id": "vpn_ops_guest",    "from": "ops_vpn",  "service": "egress",    "protocol": "tcp", "address": "10.77.70.10"},
    {"id": "app_to_vault",     "from": "api",      "service": "vault",     "protocol": "tcp"},
    {"id": "vault_to_app",     "from": "vault",    "service": "app",       "protocol": "tcp"},
    {"id": "sensor_admin",     "from": "monitor",  "service": "ops",       "protocol": "tcp"}
  ]
}
